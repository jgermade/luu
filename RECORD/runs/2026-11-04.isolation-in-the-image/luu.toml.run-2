# The policy `luu serve` runs under in its container: the session's folder
# under /work, read and write, and the commands the image carries. The
# container is the outer wall; this is the inner one, and
# `enforcement = "kernel"` asks Landlock to hold it.
#
# `.` and not `/work`: a relative path is the session's folder, so a session
# reaches its own tree and not its siblings — and on a server with users
# (`exposure = "public"`) a grant that holds every user's folder is refused.
# See RECORD/2026-11-03.a-user-a-code-and-a-folder.completed.md.
#
# Mount another file at /etc/luu/luu.toml to change it — a deployment's policy
# is the deployment's, not the image's.

[sandbox]
enforcement = "kernel"
network = false
commands = ["cargo", "rustc", "git", "rg", "ls"]

[sandbox.limits]
cpu-seconds = 300
file-size-mb = 1024

[[sandbox.paths]]
path = "."
access = "read-write"

# The toolchain, where the image keeps it.
[[sandbox.paths]]
path = "/usr/local/cargo"
access = "execute"

[[sandbox.paths]]
path = "/usr/local/rustup"
access = "execute"

# Shared by every session, and on a server with users by every user: `serve`
# says so when it starts. A cargo home per user is still open.
[[sandbox.paths]]
path = "/state/cargo"
access = "read-write"

# The run before the fix: the release's grants, /state/cargo among them, with
# only TMPDIR added so that a build links and the chain can be tried.
[sandbox.env]
TMPDIR = "./.tmp"
