ws ::= [ \t\n]*
string ::= "\"" ( [^"\\\x7F\x00-\x1F] | "\\" ( ["\\bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] ) )* "\""
empty ::= ""
edit-file-arguments-tail-2 ::= "," ws "\"path\"" ws ":" ws string empty
edit-file-arguments-tail-1 ::= "," ws "\"old_string\"" ws ":" ws string edit-file-arguments-tail-2
edit-file-arguments-tail-0 ::= "," ws "\"new_string\"" ws ":" ws string edit-file-arguments-tail-1
edit-file-arguments-head-2 ::= "\"path\"" ws ":" ws string empty
edit-file-arguments-head-1 ::= "\"old_string\"" ws ":" ws string edit-file-arguments-tail-2
edit-file-arguments-head-0 ::= "\"new_string\"" ws ":" ws string edit-file-arguments-tail-1
edit-file-arguments ::= "{" ws edit-file-arguments-head-0 ws "}"
edit-file-call ::= "\"name\"" ":" ws "\"edit_file\"" "," ws "\"arguments\"" ":" ws edit-file-arguments
list-dir-arguments-tail-0 ::= ( "," ws "\"path\"" ws ":" ws string )? empty
list-dir-arguments-head-0 ::= ( "\"path\"" ws ":" ws string empty ) | ( empty )
list-dir-arguments ::= "{" ws list-dir-arguments-head-0 ws "}"
list-dir-call ::= "\"name\"" ":" ws "\"list_dir\"" "," ws "\"arguments\"" ":" ws list-dir-arguments
integer ::= "-"? ( "0" | [1-9] [0-9]* )
read-file-arguments-tail-2 ::= ( "," ws "\"start_line\"" ws ":" ws integer )? empty
read-file-arguments-tail-1 ::= "," ws "\"path\"" ws ":" ws string read-file-arguments-tail-2
read-file-arguments-tail-0 ::= ( "," ws "\"max_lines\"" ws ":" ws integer )? read-file-arguments-tail-1
read-file-arguments-head-2 ::= ( "\"start_line\"" ws ":" ws integer empty ) | ( empty )
read-file-arguments-head-1 ::= "\"path\"" ws ":" ws string read-file-arguments-tail-2
read-file-arguments-head-0 ::= ( "\"max_lines\"" ws ":" ws integer read-file-arguments-tail-1 ) | ( read-file-arguments-head-1 )
read-file-arguments ::= "{" ws read-file-arguments-head-0 ws "}"
read-file-call ::= "\"name\"" ":" ws "\"read_file\"" "," ws "\"arguments\"" ":" ws read-file-arguments
string-array ::= "[" ws ( string ws ( "," ws string ws )* )? "]"
run-command-arguments-tail-3 ::= ( "," ws "\"timeout_ms\"" ws ":" ws integer )? empty
run-command-arguments-tail-2 ::= ( "," ws "\"cwd\"" ws ":" ws string )? run-command-arguments-tail-3
run-command-arguments-tail-1 ::= "," ws "\"command\"" ws ":" ws string run-command-arguments-tail-2
run-command-arguments-tail-0 ::= ( "," ws "\"args\"" ws ":" ws string-array )? run-command-arguments-tail-1
run-command-arguments-head-3 ::= ( "\"timeout_ms\"" ws ":" ws integer empty ) | ( empty )
run-command-arguments-head-2 ::= ( "\"cwd\"" ws ":" ws string run-command-arguments-tail-3 ) | ( run-command-arguments-head-3 )
run-command-arguments-head-1 ::= "\"command\"" ws ":" ws string run-command-arguments-tail-2
run-command-arguments-head-0 ::= ( "\"args\"" ws ":" ws string-array run-command-arguments-tail-1 ) | ( run-command-arguments-head-1 )
run-command-arguments ::= "{" ws run-command-arguments-head-0 ws "}"
run-command-call ::= "\"name\"" ":" ws "\"run_command\"" "," ws "\"arguments\"" ":" ws run-command-arguments
write-file-arguments-tail-1 ::= "," ws "\"path\"" ws ":" ws string empty
write-file-arguments-tail-0 ::= "," ws "\"content\"" ws ":" ws string write-file-arguments-tail-1
write-file-arguments-head-1 ::= "\"path\"" ws ":" ws string empty
write-file-arguments-head-0 ::= "\"content\"" ws ":" ws string write-file-arguments-tail-1
write-file-arguments ::= "{" ws write-file-arguments-head-0 ws "}"
write-file-call ::= "\"name\"" ":" ws "\"write_file\"" "," ws "\"arguments\"" ":" ws write-file-arguments
tool-call ::= "{" ws ( edit-file-call | list-dir-call | read-file-call | run-command-call | write-file-call ) ws "}"
call ::= "```tool" "\n" tool-call "\n" "```"
prose ::= [^\x00]*
root ::= prose | call

