# `luu serve` in a container: the server, and the place its tools run.
#
# Not the worker image (`/Containerfile`), whose PID 1 is `luu worker` and
# which a session starts per job. Here the container *is* the sandbox: a
# session's tools run on the host side of nothing (runtime `host`), as the
# user `luu`, inside whatever the container runtime grants — and Landlock still
# runs inside, where the kernel has it. See
# RECORD/2026-10-07.a-public-luu.completed.md.
#
#   docker build -t luu -f deploy/Containerfile .
#   docker run -p 7878:7878 -v luu-state:/state -v luu-work:/work luu
#   docker exec <container> cat /state/token
#
# Then `http://localhost:7878/?token=…`. `deploy/compose.yaml` puts Caddy in
# front for TLS.

FROM rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release --bin luu

# kubectl, for `runtime: kubernetes` in the chart: a session's worker as a
# pod. Pinned, and checked against the sha256 dl.k8s.io publishes beside it.
# See RECORD/2026-11-03.a-pod-per-session.WIP.md.
FROM rust:1-bookworm AS kubectl
ARG KUBECTL_VERSION=v1.34.1
RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    base="https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}"; \
    cd /tmp; \
    curl -fsSLO "$base/kubectl"; \
    curl -fsSLO "$base/kubectl.sha256"; \
    echo "$(cat kubectl.sha256)  kubectl" | sha256sum -c -; \
    install -m 0755 kubectl /kubectl

# xterm.js, which draws the terminal panel. The binary reads it from disk under
# LUU_UI_DIR rather than embedding it; the lockfile pins and checks it.
FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

# The rust image again, and not a slim one, on purpose: the agent's tools are
# what a shell list names — cargo, git, rg — and a container that lacks them
# is a list that says `absent`. A deployment for another language swaps this
# base.
FROM rust:1-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends ripgrep \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 10001 --create-home --home-dir /state --shell /bin/bash luu \
 && mkdir -p /work \
 && chown luu:luu /state /work
COPY --from=build /src/target/release/luu /usr/local/bin/luu
COPY --from=kubectl /kubectl /usr/local/bin/kubectl
COPY --from=web /web/node_modules/@xterm /usr/share/luu/web/node_modules/@xterm
COPY deploy/entrypoint.sh /usr/local/bin/luu-entrypoint

# The state directory (config.toml, sessions.db, the token) and the tree the
# agent works in. Both volumes: neither belongs to the image.
ENV LUU_HOME=/state \
    HOME=/state \
    CARGO_HOME=/state/cargo \
    LUU_UI_DIR=/usr/share/luu/web
VOLUME ["/state", "/work"]
WORKDIR /work
USER luu
# 2222: links from other luus, over SSH by key (`[server] ssh`).
EXPOSE 7878 2222

ENTRYPOINT ["luu-entrypoint"]
