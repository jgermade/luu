# The answer key to mixed-session.txt: line N is what a correct answer to
# question N contains, in the same order, comments and blank lines skipped on
# both sides — the convention map-order-probe.key set. Facts are separated by
# ` ; ` and every one of them is required. The field after ` <- ` is the tool
# output that carries them, so a wrong answer can be told apart from an answer
# whose evidence had left the window.
#
# A fact in backticks is a literal: those exact characters are in that output.
# A fact without them is a conclusion a person scores. Turn 11 is all
# conclusion, because a summary has no single output behind it.
#
# `crates/luu/tests/mixed_session_probe.rs` checks that every literal here is in
# what the scripted session's tools returned, so the key cannot ask for
# something the corpus never shows.

`python3 -m unittest discover -s tests` <- read_file README.md
`test_invoice_total_applies_the_discount_once` ; `4901` ; `5445` <- run_command python3, the tests
`invoice_total` ; `discount_factor` ; the discount is applied twice, once per line and again on the subtotal <- read_file orderbook/invoice.py
`A-4471` ; `UnknownRegion` ; `'IS'` <- run_command grep, logs/nightly.log
`gapless` ; skipping would leave the later invoice numbers off by one against the ledger <- read_file orderbook/nightly.py
`stopped after 140 of 180 orders` ; DE, with 33 invoices <- read_file logs/nightly.log
`A-4471,Greta Almeida,IS` ; there is no `IS` entry in REGION_RATES <- run_command grep, data/orders.csv; read_file orderbook/rates.py
`4` <- run_command grep -c, data/orders.csv
`Ran 19 tests` ; `OK` <- run_command python3, the tests after the edit
`Totals` ; `line 66` ; answered with no tool call <- turn 2's run_command, and nothing newer
the discount was applied twice and is fixed ; the nightly run stops at A-4471 because IS has no VAT rate, which is still broken <- the whole session
